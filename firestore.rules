rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Keamanan Akses: Hanya pengguna yang telah login yang dapat membaca dan menyimpan data mereka sendiri
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Akses ke seluruh sub-koleksi di bawah dokumen user masing-masing
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Blokir akses publik ke koleksi lainnya yang tidak terdaftar
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
